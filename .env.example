# TradeCalc Site Configuration
# Canonical domain used for sitemaps, OpenGraph, schemas, and canonical tags.
# In production on Vercel, this can be set to your custom domain or vercel app URL.
NEXT_PUBLIC_SITE_URL="https://tradecalc-henna.vercel.app"

# Telegram Bot Notifications (for "Suggest a Calculator" feature)
# 1. Create a bot via @BotFather on Telegram to get your bot token.
# 2. Get your chat ID (or group chat ID) via @userinfobot or Telegram API.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
